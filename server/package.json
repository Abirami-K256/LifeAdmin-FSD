{
  "name": "lifeadmin-server",
  "version": "1.0.0",
  "description": "Backend API for LifeAdmin - Personal Document Organizer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "watch": "node --watch --watch-exclude=uploads --watch-exclude=*.traineddata server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "document-organizer",
    "ocr",
    "expiry-reminder"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.14"
  }
}
