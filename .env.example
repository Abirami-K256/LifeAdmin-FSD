# Server Port and Environment
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas URI in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lifeadmin?retryWrites=true&w=majority

# JWT Signing Secret (minimum 32 random characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# AES-256-GCM Encryption Key (64-char hex string = 32 bytes)
ENCRYPTION_KEY=c7a6e12e3e57fbf02a498b8c25381669d0d34360e23846db44a60c681cfd8a24

# Brevo (Sendinblue) Transactional HTTPS Email API
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
MAIL_FROM=notifications@yourdomain.com

# External Cron Trigger Secret (Header: x-cron-secret)
CRON_SECRET=your_secure_random_cron_secret_string
